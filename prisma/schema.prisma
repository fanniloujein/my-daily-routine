// My Life OS — modèle de données
// Conventions :
//  - Les dates "calendrier" sont stockées en chaîne "YYYY-MM-DD" et les heures en "HH:mm",
//    dans le fuseau horaire local de l'utilisatrice. Cela évite les décalages de fuseau
//    pour un agenda personnel (un cours à 17 h reste à 17 h).
//  - Les champs suffixés "Enc" sont chiffrés (AES-256-GCM) au niveau applicatif.
//  - isDemo = true marque les données de démonstration, supprimables en un clic.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  locale       String   @default("fr")
  settings     Json     @default("{}")
  icsToken     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categories     Category[]
  activities     Activity[]
  energyCheckins EnergyCheckin[]
  students       Student[]
  lessons        Lesson[]
  projects       Project[]
  germanSessions GermanSession[]
  flashcards     Flashcard[]
  medications    Medication[]
  sportProfile   SportProfile?
  sportSessions  SportSession[]
  mediaItems     MediaItem[]
  leisureIdeas   LeisureIdea[]
  weeklyReviews  WeeklyReview[]
}

model Category {
  id              String   @id @default(cuid())
  userId          String
  name            String
  color           String   @default("#7aa7e0")
  icon            String   @default("tag")
  order           Int      @default(0)
  // Clé système facultative (tutoring, prep, freelance, german, sport, meds, rest, leisure, personal, admin, learning, other)
  kind            String?
  // Nature de la catégorie pour l'équilibre travail / repos : work | rest | health | personal
  balance         String   @default("personal")
  reminderMinutes Int?
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@index([userId, order])
}

enum ActivityStatus {
  TODO
  IN_PROGRESS
  DONE
  POSTPONED
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  CUSTOM
}

model Activity {
  id            String         @id @default(cuid())
  userId        String
  categoryId    String
  title         String
  date          String // YYYY-MM-DD (première occurrence)
  startTime     String? // HH:mm — null = sans horaire fixe
  endTime       String?
  durationMin   Int            @default(30)
  priority      Int            @default(2) // 1 basse, 2 normale, 3 haute, 4 urgente
  status        ActivityStatus @default(TODO)
  description   String?
  notes         String?
  isFixed       Boolean        @default(false) // rendez-vous fixe : jamais déplacé automatiquement
  energyCost    Int            @default(2) // 1 léger, 2 moyen, 3 exigeant
  dueDate       String? // échéance facultative (YYYY-MM-DD)
  reminders     Int[]          @default([]) // minutes avant le début
  recurrence    Recurrence     @default(NONE)
  interval      Int            @default(1) // tous les N jours / semaines
  weekdays      Int[]          @default([]) // 0 = dimanche … 6 = samedi (WEEKLY / CUSTOM)
  until         String? // fin de récurrence (YYYY-MM-DD)
  postponeCount Int            @default(0)
  completedAt   DateTime?
  // Liens vers les modules
  lessonId      String?
  lessonRole    String? // "session" | "prep" | "revision"
  projectTaskId String?
  germanSessionId String?
  sportSessionId  String?
  mediaItemId     String?
  isDemo        Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category            @relation(fields: [categoryId], references: [id])
  exceptions ActivityException[]
  lesson     Lesson?             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  projectTask ProjectTask?       @relation(fields: [projectTaskId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, recurrence])
}

// Modification ponctuelle d'une occurrence d'activité récurrente
model ActivityException {
  id         String          @id @default(cuid())
  activityId String
  date       String // date d'origine de l'occurrence
  status     ActivityStatus?
  cancelled  Boolean         @default(false)
  newDate    String?
  startTime  String?
  endTime    String?
  completedAt DateTime?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, date])
}

model EnergyCheckin {
  id        String   @id @default(cuid())
  userId    String
  date      String
  energy    Int // 1 très faible … 5 excellente
  mood      Int?
  stress    Int?
  note      String?
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ───────────── Cours particuliers ─────────────

model Student {
  id        String   @id @default(cuid())
  userId    String
  name      String
  level     String?
  subjects  String?
  goals     String?
  notes     String?
  color     String   @default("#8fb3e8")
  archived  Boolean  @default(false)
  // Un « groupe » est une fiche qui rassemble plusieurs élèves (cours collectif)
  isGroup   Boolean  @default(false)
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
  resources Resource[]
  members   Student[]  @relation("GroupMembers")
  groups    Student[]  @relation("GroupMembers")
}

enum LessonStatus {
  PLANNED
  DONE
  CANCELLED
}

model Lesson {
  id          String       @id @default(cuid())
  userId      String
  studentId   String
  date        String
  startTime   String
  endTime     String
  subject     String
  chapter     String?
  status      LessonStatus @default(PLANNED)
  prepMinutes Int          @default(60)
  remarks     String? // remarques après la séance
  nextSteps   String? // révisions futures prévues
  isDemo      Boolean      @default(false)
  createdAt   DateTime     @default(now())

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  student    Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  prepItems  PrepItem[]
  resources  Resource[]
  activities Activity[]

  @@index([userId, date])
}

model PrepItem {
  id       String  @id @default(cuid())
  lessonId String
  label    String
  done     Boolean @default(false)
  order    Int     @default(0)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Resource {
  id        String   @id @default(cuid())
  studentId String?
  lessonId  String?
  type      String // COURS | FICHE | EXERCICE | DOCUMENT | LIEN
  title     String
  url       String?
  content   String?
  createdAt DateTime @default(now())

  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

// ───────────── Freelance ─────────────

enum ProjectStatus {
  PROSPECT
  ACTIVE
  ON_HOLD
  DONE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  WAITING
  DONE
}

model Project {
  id          String        @id @default(cuid())
  userId      String
  client      String
  name        String
  description String?
  deadline    String?
  budget      Float?
  status      ProjectStatus @default(ACTIVE)
  priority    Int           @default(2)
  nextAction  String?
  notes       String?
  links       Json          @default("[]") // [{label, url}]
  isDemo      Boolean       @default(false)
  createdAt   DateTime      @default(now())

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks  ProjectTask[]
  events ProjectEvent[]
}

model ProjectTask {
  id          String     @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Int        @default(2)
  estimateMin Int        @default(60)
  spentMin    Int        @default(0)
  dueDate     String?
  order       Int        @default(0)
  doneAt      DateTime?
  createdAt   DateTime   @default(now())

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activities Activity[]
}

model ProjectEvent {
  id        String  @id @default(cuid())
  projectId String
  type      String // MEETING | DELIVERABLE
  title     String
  date      String
  time      String?
  done      Boolean @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ───────────── Allemand ─────────────

model GermanSession {
  id          String   @id @default(cuid())
  userId      String
  date        String
  startTime   String?
  durationMin Int      @default(30)
  topic       String // VOCAB | GRAMMAR | EXPRESSIONS | INTERVIEW | LISTENING | SPEAKING | WRITING | ERRORS
  objective   String
  done        Boolean  @default(false)
  rating      Int? // auto-évaluation 1-5
  notes       String?
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Flashcard {
  id         String    @id @default(cuid())
  userId     String
  front      String
  back       String
  example    String?
  topic      String    @default("VOCAB")
  ease       Float     @default(2.5)
  interval   Int       @default(0)
  reps       Int       @default(0)
  lapses     Int       @default(0)
  dueDate    String
  lastReview DateTime?
  isDemo     Boolean   @default(false)
  createdAt  DateTime  @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews FlashcardReview[]

  @@index([userId, dueDate])
}

model FlashcardReview {
  id          String   @id @default(cuid())
  flashcardId String
  grade       Int // 0 à revoir, 1 difficile, 2 bien, 3 facile
  reviewedAt  DateTime @default(now())

  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
}

// ───────────── Médicaments (données chiffrées) ─────────────

model Medication {
  id              String   @id @default(cuid())
  userId          String
  nameEnc         String
  dosageEnc       String? // tel que prescrit, saisi par l'utilisatrice
  instructionsEnc String?
  times           String[] // horaires prescrits "HH:mm"
  frequency       String   @default("DAILY") // DAILY | WEEKDAYS | EVERY_N_DAYS
  weekdays        Int[]    @default([])
  everyNDays      Int      @default(1)
  startDate       String
  endDate         String?
  reminderOffset  Int      @default(0) // minutes avant l'heure prescrite
  active          Boolean  @default(true)
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs MedicationLog[]
}

model MedicationLog {
  id           String    @id @default(cuid())
  medicationId String
  date         String
  time         String // horaire prévu
  status       String // TAKEN | MISSED
  takenAt      DateTime?
  createdAt    DateTime  @default(now())

  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@unique([medicationId, date, time])
}

// ───────────── Sport ─────────────

model SportProfile {
  id                 String  @id @default(cuid())
  userId             String  @unique
  goal               String?
  weeklySessions     Int     @default(3)
  weeklyMinutes      Int     @default(120)
  preferred          String[] @default([])
  availableDays      Int[]   @default([1, 3, 5])
  defaultDuration    Int     @default(45)
  preferredTime      String? // HH:mm

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SportSession {
  id          String   @id @default(cuid())
  userId      String
  date        String
  startTime   String?
  type        String
  durationMin Int      @default(45)
  intensity   Int      @default(2)
  status      String   @default("PLANNED") // PLANNED | DONE | SKIPPED
  notes       String?
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// ───────────── Loisirs ─────────────

model MediaItem {
  id          String   @id @default(cuid())
  userId      String
  title       String
  type        String   @default("MOVIE") // MOVIE | SERIES
  genre       String?
  durationMin Int      @default(110)
  status      String   @default("TO_WATCH") // TO_WATCH | WATCHING | DONE
  liked       Boolean  @default(false)
  rating      Int?
  notes       String?
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LeisureIdea {
  id          String   @id @default(cuid())
  userId      String
  title       String
  durationMin Int      @default(30)
  minEnergy   Int      @default(1)
  kind        String   @default("RELAX") // RELAX | MOVE | CREATIVE | SOCIAL | READ
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────── Bilans ─────────────

model WeeklyReview {
  id         String   @id @default(cuid())
  userId     String
  weekStart  String
  content    Json
  reflection String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}
