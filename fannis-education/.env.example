# Connexion PostgreSQL (14+). L'extension btree_gist doit être disponible (c'est le cas chez la plupart des hébergeurs).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fannis_education"

# Secret de signature des sessions (32+ caractères). Générer : openssl rand -base64 48
AUTH_SECRET=""

# URL publique de l'application (liens, cookies sécurisés en https)
APP_URL="http://localhost:3000"

# Secret pour l'appel planifié /api/cron/daily (expiration des abonnements, rappels)
CRON_SECRET=""

# Compte administrateur créé par le seed (npm run db:seed)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# Mettre à "true" pour créer aussi les comptes et contenus de démonstration
SEED_DEMO="true"

# Base dédiée aux tests d'intégration (facultatif, elle est vidée à chaque exécution !)
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fannis_test"
