# ── Base de données (obligatoire) ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mylifeos?schema=public"

# ── Sécurité (obligatoire) ──
# Secret de signature des sessions. Générer avec : openssl rand -base64 32
AUTH_SECRET="changez-moi-avec-une-valeur-aleatoire-longue"
# Clé de chiffrement des données de santé (32 octets en base64). Générer avec : openssl rand -base64 32
# ⚠️ Conservez-la précieusement : sans elle, les médicaments enregistrés deviennent illisibles.
DATA_ENCRYPTION_KEY="remplacez-par-32-octets-en-base64"

# ── Fuseau horaire (recommandé en production, serveurs souvent en UTC) ──
APP_TIMEZONE="Europe/Paris"

# ── Assistant IA (facultatif) ──
# Sans clé, l'assistant fonctionne avec son analyseur local (règles en français).
ANTHROPIC_API_KEY=""
# Modèle utilisé par l'assistant (par défaut : claude-opus-5-5)
ANTHROPIC_MODEL="claude-opus-5-5"

# ── Inscription ──
# "false" empêche la création d'un nouveau compte une fois le premier compte créé (recommandé).
ALLOW_SIGNUP="false"
