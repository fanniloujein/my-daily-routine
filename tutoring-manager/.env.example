# Base PostgreSQL (obligatoire)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tutoring?schema=public"
# Secret de signature des sessions — générer avec : openssl rand -base64 32
AUTH_SECRET="remplacez-moi-par-une-valeur-aleatoire-longue"
# Fuseau horaire de l'activité
APP_TIMEZONE="Africa/Tunis"
